# Python environment and caches
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Build outputs
dist/
build/
*.egg-info/

# PlatformIO build folder (toolchains live in ~/.platformio, D013)
firmware/.pio/

# Hydra run folders (configs, logs and results of each run)
outputs/
multirun/

# Lock files that SolidWorks (and Office) create next to an open file
~$*

# macOS
.DS_Store

# print files
*.STL

# LaTeX build outputs for the poster (main.pdf is the deliverable and stays tracked)
docs/poster/*.aux
docs/poster/*.fdb_latexmk
docs/poster/*.fls
docs/poster/*.log
docs/poster/*.synctex.gz
